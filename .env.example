# All optional. Missing keys -> clearly-labelled offline fallbacks.

# AI provider for agent + guard. Set ONE key (or both + AI_PROVIDER=claude|gemini).
# No key: rule-based agent + regex guard.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Dev/test AI spend cap (USD). Persisted in .ai-usage.json; delete that file to reset.
# Over cap -> app silently falls back to rules. Prices are per million tokens and default high (safe side).
AI_BUDGET_USD=20
AI_PRICE_IN_PER_MTOK=5
AI_PRICE_OUT_PER_MTOK=25

# PayPal sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox). Without it: simulated orders.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

PORT=3000
