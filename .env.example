# All optional. Missing keys -> clearly-labelled offline fallbacks.

# AI provider for agent + guard. Set ONE key (or several + AI_PROVIDER=openrouter|claude|gemini|vertex).
# No key: rule-based agent + regex guard.
AI_PROVIDER=
# Recommended: OpenRouter (openrouter.ai/keys). Set a credit limit on the key itself as a hard backstop.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Or Gemini via Vertex AI using your local gcloud login (local dev only). Both required, so it never
# bills gcloud's default project by accident. AI_PROVIDER=vertex if other keys are also set.
VERTEX_PROJECT=
VERTEX_ACCOUNT=
VERTEX_LOCATION=global

# Dev/test AI spend cap (USD). Persisted in .ai-usage.json; delete that file to reset.
# Over cap -> app silently falls back to rules. Prices are per million tokens and default high (safe side).
AI_BUDGET_USD=20
AI_PRICE_IN_PER_MTOK=5
AI_PRICE_OUT_PER_MTOK=25

# Channel3 real product search (channel3.ai, free 1,000 searches/month). Without it: bundled snapshot of real results.
CHANNEL3_API_KEY=

# PayPal sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox). Without it: simulated orders.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

PORT=3000

# Optional: sandbox BUSINESS account emails that act as the sellers. The winning seller gets paid directly.
# Comma separated. Without it, payments go to the app's own sandbox merchant account.
# Leave it empty for the full demo: the app can't ship or refund a payment made to another merchant
# (PayPal returns 403; that needs an approved Platform app).
SELLER_SANDBOX_EMAILS=

# Optional: PayPal webhook ID (developer dashboard -> your app -> Webhooks) for signature-verified events.
# Webhook URL: https://<your-host>/api/paypal/webhook  Events: PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.REFUNDED
PAYPAL_WEBHOOK_ID=
